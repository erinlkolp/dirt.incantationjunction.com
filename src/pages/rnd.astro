---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Two of these three programmes describe real published programs and are
// held to that by tools/check-source-drift.mjs by way of the field report;
// Blend Formulation is openly invented. Do not add technical detail to the
// first two that is not true of the Lua.
//
// The block icons reuse the three variants the homepage services cards do
// not: grass, coarse, and sand.
const programmes = [
  {
    icon: '/img/grass-block.svg',
    title: 'Autonomous Extraction',
    body:
      'A small fleet of programmable extraction units works the north face ' +
      'unattended, levelling each pad to the elevation it was set down at and ' +
      'never cutting below it. Each unit returns to the pad on its own, and ' +
      'most of them return with dirt.',
  },
  {
    icon: '/img/coarse-block.svg',
    title: 'Material Recovery',
    body:
      'A second unit walks the yard on the hour, lifting whatever the ' +
      'extraction fleet left lying about. It cruises one block above the ' +
      'litter rather than through it, and it does not dig \u2014 the only ' +
      'thing it is permitted to remove is what is already loose.',
  },
  {
    icon: '/img/sand-block.svg',
    title: 'Blend Formulation',
    body:
      'The pilot line turns a proposed recipe into a lab-panelled sample in ' +
      'under a day, which is how thirty-four standard blends emerged from ' +
      'roughly nine hundred candidates. Blend No. 0 remains sealed.',
  },
];

// A shift off the north face console. Every line here is a format string that
// really exists in turtles/flattener.lua -- including the layer summaries,
// which carry no "block(s)" suffix, unlike the total on the last line. The
// run itself is one shift's figures: the layer totals sum to the final count,
// and the unit cannot report "Nothing left up here" before layer +3, because
// SCAN_MIN holds it to four unconditional layers. Refuelling prints nothing,
// which is why the closing fuel figure is not the opening one minus travel.
const shiftLog = `=== Turtle Flattener ===
Area: 15 x 15  (225 cells)
Levelling to my current elevation. Nothing below it is touched.
Fuel: 1284
Chest expected directly behind. Ctrl+T to stop.

Layer +0: mined 203
  Inventory full - returning to chest
  Dumped 16 stack(s)
Layer +1: mined 178
  ~ Skipped cell 11,4 (blocked)
Layer +2: mined 121, 1 cell(s) unreachable
  Inventory full - returning to chest
  Dumped 14 stack(s)
Layer +3: mined 44
Layer +4: mined 12
Layer +5: mined 0
Nothing left up here. Done.

Mined 558 block(s). Fuel left: 402`;
---

<Base
  title="Research & Development — SipsCo"
  description="The SipsCo Research & Development department: autonomous extraction, substrate telemetry, and blend formulation for premium engineered soil."
>
  <Header />

  <main id="main">
    <section class="section page-head" id="top">
      <div class="wrap">
        <p class="eyebrow">Research &amp; Development</p>
        <h1>The department that digs first.</h1>
        <p class="page-lede">
          R&amp;D exists to answer one question ahead of the yard: what should
          the next blend be, and what will it take to get it out of the ground?
          Everything below is in active trial. None of it is in the catalogue
          yet.
        </p>
      </div>
    </section>

    <section class="section section-alt" aria-labelledby="unit-h">
      <div class="wrap grid-2">
        <div>
          <p class="eyebrow">Field trial</p>
          <h2 id="unit-h">Unit 7 works the night shift.</h2>
          <p>
            Our first autonomous extraction unit has been cutting the north
            face since spring, on a route it revises itself. It does not take
            breaks, it does not need the lights on, and it has never once
            asked what the dirt is for.
          </p>
          <p>
            Uptime is 94%. The remaining 6% is spent waiting for someone to
            come and empty it.
          </p>
          <p>
            Unit 7's routines are not a trade secret. The two programs that
            flatten a pad and sweep a face clean are published in full, test
            harness included. Read the <a class="text-link" href="/rnd/unit-7/"
              >field report on Unit 7</a
            > for how it works and what it structurally refuses to do, or go
            straight to the <a
              class="text-link"
              href="https://github.com/erinlkolp/computercraft-scripts"
              target="_blank"
              rel="noopener"
              >Lua source on GitHub<span class="visually-hidden"
                >&nbsp;(opens in a new tab)</span
              ></a
            >.
          </p>
        </div>
        <figure class="photo-figure">
          <img
            src="/img/mining-turtle.webp"
            width="665"
            height="557"
            alt="A white automated mining machine with a diamond pickaxe mounted on its side, parked on a grass field in front of a mossy cliff"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Unit 7 between cuts, north face. Pickaxe is consumable and rated
            for one shift.
            <span class="photo-credit">
              SipsCo &middot; <time datetime="2026-09-05">September 5, 2026</time>
            </span>
          </figcaption>
        </figure>
      </div>

      <div class="wrap">
        <figure class="console">
          <figcaption>
            North face &middot; shift of <time datetime="2026-09-04"
              >4 September 2026</time
            > &middot; <code>flattener.lua</code>
          </figcaption>
          <pre><code>{shiftLog}</code></pre>
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="programmes-h">
      <div class="wrap">
        <p class="eyebrow">Current programmes</p>
        <h2 id="programmes-h">Three things we are working on.</h2>
        <ul class="cards">
          {programmes.map((p) => (
            <li class="card">
              <img class="card-icon" src={p.icon} width="76" height="76" alt="" loading="lazy" decoding="async" />
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section-alt rnd-closing" aria-labelledby="rnd-cta-h">
      <div class="wrap">
        <h2 id="rnd-cta-h">Want a blend that does not exist yet?</h2>
        <p>
          Wholesale partners can put a formulation request straight to the
          department. We will tell you honestly whether it is soil science or
          a landscaping problem.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/#contact">Talk to the yard</a>
          <a class="btn btn-ghost" href="/news/">Read the newsroom</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* The homepage opens on a full hero; this page opens on a plain heading
     block, so it needs its own h1 sizing rather than the hero's. */
  .page-head h1 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    max-width: 18ch;
  }

  .page-lede {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 62ch;
    margin-bottom: 0;
  }

  .rnd-closing p {
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .rnd-closing .cta-row { margin-top: 1.5rem; }

  /* The console is a console in both themes, so it keeps its own colours
     rather than following the light/dark tokens -- this is what the unit
     actually writes to the terminal, and a terminal is not off-white. */
  .console {
    /* Narrower than the wrap, so it needs the auto margins to sit centred
       rather than hanging off the left edge of the section. */
    margin: 2.5rem auto 0;
    max-width: 46rem;
  }

  .console figcaption {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }

  .console figcaption code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    text-transform: none;
    letter-spacing: 0;
    color: var(--accent);
  }

  .console pre {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    border-radius: 10px;
    background: #0e1211;
    border: 1px solid #2a3432;
  }

  .console pre code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.55;
    color: #dfe6e3;
    white-space: pre;
  }

  /* Base.astro forces the page to black on white for print; a dark panel
     would come through as a solid block, so it inverts here too. */
  @media print {
    .console pre {
      background: none;
      border-color: #999;
    }

    .console pre code { color: #000; }
  }
</style>
