---
import Base from '../layouts/Base.astro';

// NOTE: All copy below is placeholder/demo content for SipsCo (premium dirt).
// Replace the strings in `services`, `stats`, and the section prose with real
// company information before treating this as a live corporate site.

const year = new Date().getFullYear();

const services = [
  {
    icon: '/img/strata-block.svg',
    title: 'Custom Blending',
    body: 'We formulate to your spec — texture class, drainage, organic fraction, pH — and keep the recipe on file so the next order matches the last one.',
  },
  {
    icon: '/img/dirt-block.svg',
    title: 'Testing & Analysis',
    body: 'In-house lab work on every batch: particle size, organic matter, pH, soluble salts, and macronutrients, reported before the truck leaves the yard.',
  },
  {
    icon: '/img/stack-block.svg',
    title: 'Bulk Delivery',
    body: 'Live-bottom and dump delivery by the cubic yard, plus supersack and bagged formats for sites where a tipping truck will not fit.',
  },
];

const news = [
  {
    datetime: '2026-09-06',
    date: 'September 6, 2026',
    tag: 'Company',
    title: 'SipsCo to unveil third blending plant in October',
    body:
      'The new yard comes online next month, adding a fourth blending line, a ' +
      'second on-site lab, and enough covered storage to hold winter stock ' +
      'without tarping it. Tours for wholesale partners open the week after ' +
      'commissioning.',
    lead: true,
    image: '/img/sjin-factory-tour.webp',
    imageAlt:
      'A player character labelled Sjin standing on a walkway above the new ' +
      'plant, orange gantries and a settling pond behind, in heavy rain',
    caption:
      'CEO Sjin on site at the new plant, ahead of October commissioning.',
  },
  {
    datetime: '2026-08-18',
    date: 'August 18, 2026',
    tag: 'Operations',
    title: 'Standard lead time drops to 48 hours',
    body:
      'Second shift at the main yard cuts the typical order-to-delivery window ' +
      'from four days to two across all standard blends.',
    lead: false,
  },
  {
    datetime: '2026-07-02',
    date: 'July 2, 2026',
    tag: 'Product',
    title: 'Coarse Blend No. 7 returns to the catalogue',
    body:
      'Back by request from the drainage crowd, with the same particle spec as ' +
      'the original run and a fresh lab panel on every batch.',
    lead: false,
  },
];

const stats = [
  { figure: '220K', label: 'Cubic yards delivered yearly' },
  { figure: '34', label: 'Standard blends' },
  { figure: '48h', label: 'Typical lead time' },
  { figure: '100%', label: 'Batches lab-tested' },
];
---

<Base
  title="SipsCo — Premium dirt, engineered to grow"
  description="SipsCo blends, tests, and delivers premium topsoil, compost, and custom growing substrates for commercial growers, landscape contractors, and municipal projects."
>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">SipsCo</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav">
          <li><a href="#about">About</a></li>
          <li class="nav-wide"><a href="#services">What we do</a></li>
          <li class="nav-wide"><a href="#numbers">Company</a></li>
          <li class="nav-wide"><a href="#news">News</a></li>
          <li><a class="nav-cta" href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap hero-inner">
        <div class="hero-copy">
        <p class="eyebrow">Soil blending &amp; bulk supply</p>
        <h1>Premium dirt. Engineered to grow.</h1>
        <p class="lede">
          SipsCo blends, tests, and delivers topsoil, compost, and custom
          substrates for commercial growers, landscape contractors, and
          municipal projects — every batch with a lab report attached.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact">Request a quote</a>
          <a class="btn btn-ghost" href="#services">See what we do</a>
        </div>
        </div>
        <div class="hero-art">
          <img
            src="/img/grass-block.svg"
            width="340"
            height="340"
            alt="Isometric pixel-art block of grass-topped soil"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-h">
      <div class="wrap grid-2">
        <div>
          <p class="eyebrow">About</p>
          <h2 id="about-h">Dirt is a specification, not a commodity.</h2>
        </div>
        <div>
          <p>
            Most soil is sold by the truckload and described by the adjective.
            We treat it as a spec: every SipsCo blend carries a documented
            texture class, organic matter fraction, pH range, and nutrient
            profile, and every delivery ships with the lab report for that
            batch.
          </p>
          <p>
            That means a grower can reorder in March and get the same medium
            they dialed in last August. It is an unglamorous promise, and it is
            the entire company.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="services" aria-labelledby="services-h">
      <div class="wrap">
        <p class="eyebrow">What we do</p>
        <h2 id="services-h">Three capabilities, one yard.</h2>
        <ul class="cards">
          {services.map((s) => (
            <li class="card">
              <img
                class="card-icon"
                src={s.icon}
                width="76"
                height="76"
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="customers" aria-labelledby="customers-h">
      <div class="wrap customers-inner">
        <div>
          <p class="eyebrow">Customers</p>
          <h2 id="customers-h">Another happy customer.</h2>
          <p>
            Our blends move fast. A few of them move on their own. We do not
            chase these down, and we do not count them against the yard.
          </p>
        </div>
        <figure class="customer-figure">
          <img
            src="/img/another-happy-customer.webp"
            width="817"
            height="479"
            alt="A tall black figure carrying a single block of soil across a grass field"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Unverified customer relocating roughly 0.03 yd&sup3; of Standard
            Topsoil, unassisted and without a quote.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section-alt" id="numbers" aria-labelledby="numbers-h">
      <div class="wrap">
        <p class="eyebrow">By the numbers</p>
        <h2 id="numbers-h">The company at a glance.</h2>
        <dl class="stats">
          {stats.map((s) => (
            <div class="stat">
              <dt class="stat-figure">{s.figure}</dt>
              <dd class="stat-label">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section" id="news" aria-labelledby="news-h">
      <div class="wrap">
        <p class="eyebrow">Newsroom</p>
        <h2 id="news-h">Latest from the yard.</h2>
        <ul class="news-list">
          {news.map((item) => (
            <li class={item.lead ? 'news-item news-lead' : 'news-item'}>
              <div class="news-meta">
                <time datetime={item.datetime}>{item.date}</time>
                <span class="news-tag">{item.tag}</span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {item.image && (
                <figure class="news-figure">
                  <img
                    src={item.image}
                    width="1052"
                    height="551"
                    alt={item.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{item.caption}</figcaption>
                </figure>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-h">
      <div class="wrap contact-inner">
        <div>
          <h2 id="contact-h">Tell us what you're growing.</h2>
          <p>
            Send a spec, a soil test, or just a description of the site — we
            will come back with a blend recommendation and a quote within two
            business days.
          </p>
        </div>
        <ul class="contact-list">
          <li>
            <span class="contact-label">General</span>
            <a href="mailto:hello@dirt.incantationjunction.com">hello@dirt.incantationjunction.com</a>
          </li>
          <li>
            <span class="contact-label">Bulk orders</span>
            <a href="mailto:orders@dirt.incantationjunction.com">orders@dirt.incantationjunction.com</a>
          </li>
          <li>
            <span class="contact-label">Press</span>
            <a href="mailto:press@dirt.incantationjunction.com">press@dirt.incantationjunction.com</a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer" aria-labelledby="footer-h">
    <h2 id="footer-h" class="visually-hidden">Site footer</h2>
    <div class="wrap">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href="#top">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">SipsCo</span>
          </a>
          <p class="footer-blurb">
            Blending, testing, and delivering premium dirt by the cubic yard.
          </p>
        </div>

        <nav class="footer-col" aria-label="Company">
          <h3>Company</h3>
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#numbers">At a glance</a></li>
            <li><a href="#news">News</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href="mailto:press@dirt.incantationjunction.com">Press</a></li>
          </ul>
        </nav>

        <nav class="footer-col" aria-label="Services">
          <h3>Services</h3>
          <ul>
            <li><a href="#services">Custom blending</a></li>
            <li><a href="#services">Testing &amp; analysis</a></li>
            <li><a href="#services">Bulk delivery</a></li>
            <li><a href="mailto:orders@dirt.incantationjunction.com">Wholesale</a></li>
          </ul>
        </nav>

        <nav class="footer-col" aria-label="Legal">
          <h3>Legal</h3>
          <ul>
            {/* Placeholder destinations — no legal pages exist yet. */}
            <li><a href="#">Privacy policy</a></li>
            <li><a href="#">Terms of service</a></li>
            <li><a href="#">Cookie policy</a></li>
            <li><a href="#">Accessibility</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-bottom">
        <div class="footer-legal">
          <p class="motto">Big Money, Big Women, Big Fun&trade;</p>
          <p class="copyright">&copy; {year} SipsCo. All rights reserved.</p>
        </div>
        <p class="footer-note">
          Built with Astro. Hosted on GitHub Pages. Photography on this site
          consists of Minecraft screenshots; not affiliated with or endorsed by
          Mojang Studios.
        </p>
      </div>
    </div>
  </footer>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  /* ---------- header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.15rem;
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--brand);
    position: relative;
    flex: none;
  }

  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 2px solid var(--brand-ink);
    border-radius: 50% 0 50% 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }

  .nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-weight: 550;
  }

  .nav a:hover { color: var(--ink); }

  .nav-cta {
    background: var(--brand);
    color: var(--brand-ink) !important;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
  }

  /* Class-based rather than nth-child so adding nav items cannot silently
     change which one gets hidden on narrow screens. */
  .nav-wide { display: none; }

  @media (min-width: 760px) {
    .nav-wide { display: list-item; }
  }

  /* ---------- hero ---------- */
  .hero {
    padding: clamp(3.5rem, 11vw, 7.5rem) 0 clamp(3rem, 8vw, 5.5rem);
    background:
      radial-gradient(
        70ch 40ch at 15% -10%,
        color-mix(in srgb, var(--brand) 16%, transparent),
        transparent 70%
      ),
      var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    gap: clamp(2rem, 6vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  .hero-copy { max-width: 62ch; }

  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.1fr 0.9fr; }
  }

  .hero-art {
    display: flex;
    justify-content: center;
  }

  .hero-art img {
    width: min(340px, 72vw);
    height: auto;
    filter: drop-shadow(0 18px 26px rgb(0 0 0 / 0.28));
    animation: hover-block 6s ease-in-out infinite;
  }

  @keyframes hover-block {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .card-icon {
    width: 76px;
    height: auto;
    margin-bottom: 1rem;
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.22));
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6.2vw, 4rem);
    margin-bottom: 0.4em;
  }

  .lede {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }

  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btn:hover { transform: translateY(-1px); }

  .btn-primary { background: var(--brand); color: var(--brand-ink); }

  .btn-ghost { border-color: var(--line); background: var(--surface); }

  /* ---------- sections ---------- */
  .section { padding: clamp(3rem, 8vw, 5.5rem) 0; }

  .section-alt {
    background: var(--surface-alt);
    border-block: 1px solid var(--line);
  }

  .section h2 { font-size: clamp(1.6rem, 3.6vw, 2.3rem); }

  .grid-2 {
    display: grid;
    gap: clamp(1rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 800px) {
    .grid-2 { grid-template-columns: 1fr 1.15fr; }
  }

  .grid-2 p { color: var(--ink-soft); }

  /* ---------- cards ---------- */
  .cards {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
  }

  .card h3 { font-size: 1.15rem; }

  .card p { color: var(--ink-soft); margin: 0; }

  /* ---------- stats ---------- */
  .stats {
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  }

  .stat {
    border-top: 3px solid var(--brand);
    padding-top: 1rem;
  }

  .stat-figure {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* ---------- contact ---------- */
  .contact {
    background: var(--brand);
    color: var(--brand-ink);
  }

  .contact .eyebrow { color: inherit; opacity: 0.8; }

  .contact p { opacity: 0.9; max-width: 46ch; }

  .contact-inner {
    display: grid;
    gap: clamp(1.5rem, 5vw, 3rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 800px) {
    .contact-inner { grid-template-columns: 1.2fr 1fr; }
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    padding-top: 0.7rem;
  }

  .contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.75;
  }

  .contact-list a {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 45%, transparent);
    align-self: flex-start;
  }

  /* ---------- customers ---------- */
  .customers-inner {
    display: grid;
    gap: clamp(1.75rem, 5vw, 3rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 860px) {
    .customers-inner { grid-template-columns: 0.85fr 1.15fr; }
  }

  .customers-inner > div p { color: var(--ink-soft); max-width: 44ch; }

  .customer-figure { margin: 0; }

  .customer-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .customer-figure figcaption {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  /* ---------- news ---------- */
  .news-list {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    /* Explicit two-up rather than auto-fit: auto-fit yields four tracks at
       desktop width, leaving the two secondary items stranded in half a row. */
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .news-list { grid-template-columns: repeat(2, 1fr); }
  }

  .news-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
  }

  .news-item h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .news-item p { color: var(--ink-soft); margin: 0; }

  .news-lead {
    border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
    border-top: 3px solid var(--brand);
  }

  @media (min-width: 860px) {
    /* Lead item keeps the full width for prominence, but lays the photo
       beside the copy instead of stacking it, which roughly halves the
       item's height. */
    .news-lead {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 2.25rem);
      align-items: start;
    }

    .news-lead .news-figure {
      grid-column: 1;
      grid-row: 1 / span 3;
      margin: 0;
      align-self: center;
    }

    .news-lead .news-meta { grid-column: 2; grid-row: 1; }
    .news-lead h3 {
      grid-column: 2;
      grid-row: 2;
      font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    }
    .news-lead p { grid-column: 2; grid-row: 3; max-width: 52ch; }
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .news-tag {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-weight: 650;
    color: var(--accent);
  }

  .news-figure {
    margin: 1.4rem 0 0;
  }

  .news-figure img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 4px);
    border: 1px solid var(--line);
  }

  .news-figure figcaption {
    margin-top: 0.7rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* ---------- footer ---------- */
  .site-footer {
    background: var(--surface-alt);
    border-top: 1px solid var(--line);
    padding: clamp(2.5rem, 6vw, 4rem) 0 1.75rem;
    font-size: 0.95rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (min-width: 940px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
    .footer-brand { grid-column: auto; }
  }

  .footer-blurb {
    color: var(--ink-soft);
    margin: 0.9rem 0 0;
    max-width: 34ch;
  }

  .footer-col h3 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .footer-col a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-bottom {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
