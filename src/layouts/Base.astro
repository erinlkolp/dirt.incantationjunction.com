---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SipsCo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#0d5b53" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101413" media="(prefers-color-scheme: dark)" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230d5b53'/%3E%3Cpath d='M23 9c0 7-4.5 11-11 11-1 0-2-.2-2-.2C10 13 15 9 23 9z' fill='%23f0c98a'/%3E%3Cpath d='M9 24c0-5 4-9 9-11' fill='none' stroke='%23f0c98a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <style is:global>
      :root {
        --bg: #faf7f2;
        --surface: #ffffff;
        --surface-alt: #f2ece2;
        --ink: #1a1d1c;
        --ink-soft: #545c59;
        --line: #e2dacd;
        --brand: #0d5b53;
        --brand-ink: #ffffff;
        --accent: #b4762c;
        --radius: 14px;
        --maxw: 1120px;
        --pad: clamp(1.25rem, 4vw, 2.5rem);
        color-scheme: light;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #101413;
          --surface: #171d1c;
          --surface-alt: #1d2523;
          --ink: #e9edeb;
          --ink-soft: #a3aeaa;
          --line: #2a3432;
          --brand: #47c9b5;
          --brand-ink: #06211d;
          --accent: #dda863;
          color-scheme: dark;
        }
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { animation: none !important; transition: none !important; }
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 {
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 0.5em;
        font-weight: 650;
      }

      p { margin: 0 0 1rem; }

      a { color: inherit; }

      img { max-width: 100%; display: block; }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--pad);
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--brand);
        color: var(--brand-ink);
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus { left: 0; }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }

      /* ---------- shared primitives ----------
         Rules used by more than one page or component. Anything used by a
         single page stays scoped inside that page instead. */

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--accent);
        margin: 0 0 0.75rem;
      }

      /* The brand lockup appears in both the header and the footer, so it
         cannot live scoped inside either one. */
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        font-weight: 700;
        letter-spacing: -0.02em;
        font-size: 1.15rem;
      }

      .brand-mark {
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: var(--brand);
        position: relative;
        flex: none;
      }

      .brand-mark::after {
        content: '';
        position: absolute;
        inset: 6px;
        border: 2px solid var(--brand-ink);
        border-radius: 50% 0 50% 0;
      }

      .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }

      .btn {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        border: 1px solid transparent;
        transition: transform 0.15s ease, background 0.15s ease;
      }

      .btn:hover { transform: translateY(-1px); }

      .btn-primary { background: var(--brand); color: var(--brand-ink); }

      .btn-ghost { border-color: var(--line); background: var(--surface); }

      /* Links set in running prose. Every other link on the site is a nav
         item or a button and styles itself; this is the one that has to look
         like a link inside a sentence. */
      .text-link {
        color: var(--brand);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-thickness: 1px;
        font-weight: 550;
      }

      .text-link:hover { text-decoration-thickness: 2px; }

      .section { padding: clamp(3rem, 8vw, 5.5rem) 0; }

      .section-alt {
        background: var(--surface-alt);
        border-block: 1px solid var(--line);
      }

      .section h2 { font-size: clamp(1.6rem, 3.6vw, 2.3rem); }

      .grid-2 {
        display: grid;
        gap: clamp(1rem, 4vw, 3rem);
        grid-template-columns: 1fr;
      }

      @media (min-width: 800px) {
        .grid-2 { grid-template-columns: 1fr 1.15fr; }
      }

      .grid-2 p { color: var(--ink-soft); }

      .cards {
        list-style: none;
        margin: 2.25rem 0 0;
        padding: 0;
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.6rem;
      }

      .card h3 { font-size: 1.15rem; }

      .card p { color: var(--ink-soft); margin: 0; }

      .card-icon {
        width: 76px;
        height: auto;
        margin-bottom: 1rem;
        filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.22));
      }

      /* Photo frame and date credit shared by every figure on the site.
         Pages layer their own spacing and corner radius on top; a page's
         scoped rules outrank these, so overriding needs only the delta. */
      .photo-figure { margin: 0; }

      .photo-figure img {
        width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--line);
        background: var(--surface);
      }

      .photo-figure figcaption {
        margin-top: 0.85rem;
        font-size: 0.875rem;
        color: var(--ink-soft);
      }

      /* Date credit sits on its own line under the caption, set in the same
         uppercase key as .news-meta so the two dates read as one system. */
      .photo-credit {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: color-mix(in srgb, var(--ink-soft) 75%, transparent);
      }
    </style>
  </body>
</html>
